# Environment variables for the Netlify Functions backend.
# Copy the real values into the Netlify dashboard:
#   Site configuration -> Environment variables
# The values you actually need are in the local, git-ignored .env file.

# Supabase project URL
SUPABASE_URL=https://txusshocoamqmxsbbrdm.supabase.co

# Publishable key — safe to be public; RLS only allows INSERTs from it.
# Used by the /api/capture function to store submissions (including the real
# password — the instructor opted in for the full demo experience).
SUPABASE_ANON_KEY=sb_publishable_...

# Service role key — KEEP SECRET. Bypasses RLS; used only by the
# /password function to read the captures. Never put this in front-end code.
SUPABASE_SERVICE_KEY=sb_secret_...

# Passcode protecting the /password instructor dashboard (Basic Auth,
# username is always "instructor").
DEMO_INSTRUCTOR_PASS=set-your-own-passcode
